{
  "name": "@inntris/trust-badge",
  "version": "1.0.0",
  "description": "Trust Badge widget for Inntris Core verified agents",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/TrustBadge.tsx --format cjs,esm --dts",
