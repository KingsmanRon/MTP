{
  "name": "@inntris/trust-badge",
  "version": "1.0.0",
  "description": "Trust Badge widget for Inntris Core verified agents",
  "main": "dist/TrustBadge.js",
  "module": "dist/TrustBadge.mjs",
  "types": "dist/TrustBadge.d.ts",
  "exports": {
    ".": {
      "types": "./dist/TrustBadge.d.ts",
      "import": "./dist/TrustBadge.mjs",
      "require": "./dist/TrustBadge.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/TrustBadge.tsx --format cjs,esm --dts",
    "dev": "tsup src/TrustBadge.tsx --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "inntris",
    "ai-agents",
    "verification",
    "trust-score",
    "badge",
    "widget",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  }
}
