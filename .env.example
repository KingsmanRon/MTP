# =============================================================================
# INNTRIS CORE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Protecting Intellect. The Universal Liability Shield for Autonomous Agents.
# Copy this file to .env and configure for your environment
# NEVER commit the actual .env file to version control!
# © 2026 Inntris INC. All rights reserved.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Options: development, staging, production

# -----------------------------------------------------------------------------
# Database (PostgreSQL/Supabase)
# -----------------------------------------------------------------------------
# Compose uses this owner only for initialisation and migrations. Generate two
# different passwords with `openssl rand -hex 32`. Blank values make Compose
# fail closed rather than starting with a shared default credential.
POSTGRES_USER=inntris_migrator
POSTGRES_PASSWORD=
POSTGRES_DB=inntris
RUNTIME_DATABASE_PASSWORD=

# The migration DSN is supplied only to the one-shot migrate service. API and
# worker services receive only the inntris_worker runtime DSN. URL encode any
# reserved password characters.
ALEMBIC_DATABASE_URL=
DATABASE_URL=
# ALEMBIC_DATABASE_URL=postgresql://inntris_migrator:MIGRATION_PASSWORD@postgres:5432/inntris
# DATABASE_URL=postgresql://inntris_worker:RUNTIME_PASSWORD@postgres:5432/inntris

# For Supabase, create the same owner and runtime split using project DSNs.

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Self-hosted Compose requires authentication and does not publish Redis.
REDIS_PASSWORD=
REDIS_URL=
# REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379/0

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_PORT=8000
SERVER_SECRET=generate_a_secure_64_character_secret_here_using_openssl_rand
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# Operator master key — gates POST /admin/organizations (org provisioning).
# Leave UNSET to disable provisioning entirely. When set it MUST be >= 32 chars
# (shorter keys are ignored and provisioning stays disabled). Sent by operator
# tooling as the X-Master-Key header; partners never use it. Generate with:
#   openssl rand -hex 32
MASTER_ADMIN_KEY=

# -----------------------------------------------------------------------------
# Blockchain (Base L2)
# -----------------------------------------------------------------------------
# Base Mainnet (default)
BLOCKCHAIN_PROVIDER_URL=https://base-rpc.publicnode.com

# Base Sepolia Testnet (for development/testing only)
# BLOCKCHAIN_PROVIDER_URL=https://base-sepolia-rpc.publicnode.com

# AnchorRegistry Contract Address (deploy and update this)
ANCHOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key for the anchor worker (without 0x prefix)
# SECURITY: Generate a dedicated wallet for this purpose
# Use a hardware wallet or secure key management in production
BLOCKCHAIN_PRIVATE_KEY=your_private_key_without_0x_prefix

# -----------------------------------------------------------------------------
# Anchor Worker
# -----------------------------------------------------------------------------
ANCHOR_BATCH_SIZE=1000
# Ten minutes equals the worker's 600 second default.
ANCHOR_INTERVAL_MINUTES=10
ANCHOR_METRICS_ENABLED=true
ANCHOR_METRICS_PORT=9100
# Direct worker runs stay loopback only. Compose overrides this inside its
# private network and does not publish the metrics port.
ANCHOR_METRICS_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# Verification abuse controls and durable webhook recovery
# -----------------------------------------------------------------------------
VERIFY_SOURCE_ATTEMPTS_PER_MINUTE=300
VERIFY_AGENT_ATTEMPTS_PER_MINUTE=120
VERIFY_AGENT_SIGNATURE_CONCURRENCY=20
WEBHOOK_RECOVERY_POLL_SECONDS=5
WEBHOOK_RECOVERY_BATCH_SIZE=50

# Derive the caller address from X-Forwarded-For instead of the socket peer.
# Off for local development (no proxy). Enable ONLY behind a trusted edge —
# see .env.production.template for the hop-count model.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
WEBHOOK_DELIVERY_CONCURRENCY=20

# -----------------------------------------------------------------------------
# MCP Server (Agent Configuration)
# -----------------------------------------------------------------------------
INNTRIS_API_URL=http://localhost:8000
INNTRIS_AGENT_ID=your_agent_uuid_here
INNTRIS_PRIVATE_KEY_B64=your_base64_encoded_ed25519_private_key
INNTRIS_TIMEOUT=30

# -----------------------------------------------------------------------------
# Optional: pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Optional: Monitoring & Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn
# DATADOG_API_KEY=your_datadog_api_key
