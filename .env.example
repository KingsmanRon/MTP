# =============================================================================
# MACHINE TRUST PROTOCOL - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure for your environment
# NEVER commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Options: development, staging, production

# -----------------------------------------------------------------------------
# Database (PostgreSQL/Supabase)
# -----------------------------------------------------------------------------
POSTGRES_USER=mtp
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mtp
POSTGRES_PORT=5432

# Full connection URL (overrides individual settings)
DATABASE_URL=postgresql://mtp:your_secure_password_here@localhost:5432/mtp

# For Supabase, use the connection string from your dashboard:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_PORT=8000
SERVER_SECRET=generate_a_secure_64_character_secret_here_using_openssl_rand
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# -----------------------------------------------------------------------------
# Blockchain (Base L2)
# -----------------------------------------------------------------------------
# Base Mainnet
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia (Testnet)
# BASE_RPC_URL=https://sepolia.base.org

# AnchorRegistry Contract Address (deploy and update this)
ANCHOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key for the anchor worker (without 0x prefix)
# SECURITY: Generate a dedicated wallet for this purpose
# Use a hardware wallet or secure key management in production
BLOCKCHAIN_PRIVATE_KEY=your_private_key_without_0x_prefix

# -----------------------------------------------------------------------------
# Anchor Worker
# -----------------------------------------------------------------------------
ANCHOR_BATCH_SIZE=1000
ANCHOR_BATCH_INTERVAL=3600

# -----------------------------------------------------------------------------
# MCP Server (Agent Configuration)
# -----------------------------------------------------------------------------
MTP_API_URL=http://localhost:8000
MTP_AGENT_ID=your_agent_uuid_here
MTP_PRIVATE_KEY_B64=your_base64_encoded_ed25519_private_key
MTP_TIMEOUT=30

# -----------------------------------------------------------------------------
# Optional: pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@mtp.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Optional: Monitoring & Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn
# DATADOG_API_KEY=your_datadog_api_key
