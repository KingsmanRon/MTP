# ==============================================================================
# INNTRIS CORE - PRODUCTION ENVIRONMENT
# ==============================================================================
# CRITICAL: This file contains sensitive production credentials.
# - DO NOT commit this file to version control
# - Store securely in Railway/Render environment variables
# - Backup encrypted copy in password manager
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# The API and anchor worker read ONLY `DATABASE_URL` for the locked down
# inntris_worker role. The one-shot migration job alone receives
# `ALEMBIC_DATABASE_URL` for the database owner. Never expose that owner DSN to
# a runtime service. `RUNTIME_DATABASE_PASSWORD` provisions the runtime login
# immediately after migrations without storing a credential in migration history.
# DATABASE_URL is a single libpq connection
# string). A per-field DATABASE_HOST/PORT/NAME/USER/PASSWORD form is NOT read —
# if DATABASE_URL is unset the app silently falls back to its dev default and
# fails to connect. The connection pool (min 5 / max 20) is configured in code.
#
# Railway: expose the plugin owner URL only to the migration job. Create a
#          separate inntris_worker URL for the long-running services.
# Supabase: copy the POOLED connection string (Project Settings → Database →
#           Connection string → "Connection pooling", the :6543 host) and append
#           sslmode=require.
# Generate distinct owner and runtime values with: openssl rand -hex 32
ALEMBIC_DATABASE_URL=postgresql://OWNER:OWNER_PASSWORD@HOST:5432/postgres?sslmode=require
RUNTIME_DATABASE_PASSWORD=REPLACE_WITH_SEPARATE_64_HEX_CHARACTERS
DATABASE_URL=postgresql://inntris_worker:RUNTIME_PASSWORD@HOST:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (Railway Auto-Config)
# ------------------------------------------------------------------------------
# On Railway, use: ${{Redis.REDIS_URL}}
# On other platforms, format: redis://username:password@host:port/db
# Self-hosted Compose also requires this separate value and keeps Redis internal.
REDIS_PASSWORD=REPLACE_WITH_SEPARATE_64_HEX_CHARACTERS
REDIS_URL=redis://default:REPLACE_WITH_REDIS_PASSWORD@redis.railway.internal:6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# BLOCKCHAIN CONFIGURATION (Base L2)
# ------------------------------------------------------------------------------
# Choose ONE:
# - Base Mainnet: https://base-rpc.publicnode.com (Chain ID: 8453)
# - Base Sepolia Testnet: https://base-sepolia-rpc.publicnode.com (Chain ID: 84532)
BLOCKCHAIN_PROVIDER_URL=https://base-rpc.publicnode.com
BLOCKCHAIN_CHAIN_ID=8453

# CRITICAL: Private key for submitting anchor transactions
# Format: 0x... (64 hex characters)
# This wallet needs ~0.1 ETH for gas fees
BLOCKCHAIN_PRIVATE_KEY=0xREPLACE_WITH_YOUR_PRIVATE_KEY_64_HEX_CHARS

# Contract address (from deployment)
ANCHOR_CONTRACT_ADDRESS=0xREPLACE_WITH_DEPLOYED_CONTRACT_ADDRESS

# Anchoring configuration
ANCHOR_BATCH_SIZE=1000
# The anchor block timestamp is the trustless upper bound on when each audit
# entry existed; 10 minutes keeps that bound tight at negligible Base gas cost.
ANCHOR_INTERVAL_MINUTES=10
ANCHOR_GAS_LIMIT=500000
ANCHOR_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# API SECURITY
# ------------------------------------------------------------------------------
# CRITICAL: Generate with: openssl rand -hex 64
# Used for signing approval tokens (HMAC-SHA256)
SERVER_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING

# CRITICAL: Generate with: openssl rand -hex 32
# Used for /admin/organizations endpoint (creating orgs)
# Keep this EXTREMELY secure - it's your master key!
MASTER_ADMIN_KEY=REPLACE_WITH_32_BYTE_HEX_STRING

# JWT configuration
JWT_EXPIRY_HOURS=24
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# CRITICAL: Set to your actual production domains
# Comma-separated list, no spaces
ALLOWED_ORIGINS=https://inntris.com

# For development/testing, you can add:
# ALLOWED_ORIGINS=https://inntris.com,http://localhost:3000

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
# Per-agent rate limits
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Global rate limits
GLOBAL_RATE_LIMIT_PER_SECOND=1000

# Anti-abuse
MAX_REQUESTS_PER_IP_PER_HOUR=10000

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# For Railway/Render, use their $PORT variable:
# On Railway: PORT is auto-set
# On Render: PORT is auto-set
PORT=8000

# Uvicorn workers (set to 2x CPU cores)
WORKERS=4
MAX_REQUESTS=10000
MAX_REQUESTS_JITTER=1000

# ------------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Enable detailed metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Sentry (optional, for error tracking)
# Get from: sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Datadog (optional, for APM)
# DD_API_KEY=xxx
# DD_SERVICE=mtp-api
# DD_ENV=production

# ------------------------------------------------------------------------------
# WEBHOOKS
# ------------------------------------------------------------------------------
# Durable outbox recovery. Delivery uses fixed safe bounds: HTTPS port 443,
# three cumulative attempts, no redirects, and a 64 KiB response limit.
WEBHOOK_RECOVERY_POLL_SECONDS=5
WEBHOOK_RECOVERY_BATCH_SIZE=50
WEBHOOK_DELIVERY_CONCURRENCY=20

# ------------------------------------------------------------------------------
# TRUST SCORING
# ------------------------------------------------------------------------------
# Trust score decay rate (points per day of inactivity)
TRUST_DECAY_PER_DAY=1

# Minimum trust score for verification
MIN_TRUST_SCORE_FOR_VERIFICATION=50

# ------------------------------------------------------------------------------
# SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Signature verification
SIGNATURE_VERIFICATION_STRICT=true

# Nonce replay window (seconds)
NONCE_REPLAY_WINDOW=300

# Unauthenticated verification attempt budgets, enforced before signature work.
# Redis failure causes verification to fail closed with HTTP 503.
VERIFY_SOURCE_ATTEMPTS_PER_MINUTE=300
VERIFY_AGENT_ATTEMPTS_PER_MINUTE=120
VERIFY_AGENT_SIGNATURE_CONCURRENCY=20

# Client identity behind the platform edge. REQUIRED on Railway and any other
# proxied deployment: without it every caller shares the proxy's address, the
# per-source budget above becomes one global bucket, and audit request_ip
# records the proxy. TRUSTED_PROXY_HOPS is the number of proxies guaranteed in
# front of the service (Railway edge = 1; CDN in front of that = 2). Only
# enable when the listener is unreachable except through that proxy chain.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# Maximum request body size (MB)
MAX_REQUEST_SIZE_MB=10

# Enable audit log encryption at rest
AUDIT_LOG_ENCRYPTION=true

# ------------------------------------------------------------------------------
# WORKER CONFIGURATION (for anchor_worker)
# ------------------------------------------------------------------------------
# Worker health check interval (seconds)
WORKER_HEALTH_CHECK_INTERVAL=60

# Required Prometheus heartbeat and proof backlog endpoint
ANCHOR_METRICS_ENABLED=true
ANCHOR_METRICS_PORT=9100
# Compose overrides this inside its private network without publishing the
# port. Direct worker deployments remain loopback only.
ANCHOR_METRICS_ADDRESS=127.0.0.1

# Minimum balance alert threshold (ETH)
MIN_BALANCE_ALERT_THRESHOLD=0.01

# Enable worker notifications
WORKER_NOTIFICATIONS_ENABLED=true

# ------------------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY
# ------------------------------------------------------------------------------
# Enable automatic backups (if supported by platform)
AUTO_BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
# Enable experimental features
ENABLE_BATCH_VERIFICATION=true
ENABLE_MERKLE_PROOFS=true
ENABLE_TRUST_BADGES=true

# ------------------------------------------------------------------------------
# COMPLIANCE & LEGAL
# ------------------------------------------------------------------------------
# Data retention period (days)
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for compliance

# Enable GDPR compliance features
GDPR_ENABLED=true

# Terms of service URL
TERMS_OF_SERVICE_URL=https://inntris.com/terms

# ==============================================================================
# DEPLOYMENT CHECKLIST
# ==============================================================================
# Before deploying to production:
#
# Required database boundary:
#   Set ALEMBIC_DATABASE_URL only on the migration job.
#   Set DATABASE_URL to the separate inntris_worker login on runtime services.
#   Generate a distinct RUNTIME_DATABASE_PASSWORD and provision after migrations.
#   Require an authenticated REDIS_URL and never publish Redis to the host.
#
# ✅ Replace ALL "REPLACE_WITH_*" values above
# ✅ Keep the owner DSN on the migration job and the worker DSN on runtime services
# ✅ Generate SERVER_SECRET: openssl rand -hex 64
# ✅ Generate MASTER_ADMIN_KEY: openssl rand -hex 32
# ✅ Deploy smart contract and set ANCHOR_CONTRACT_ADDRESS
# ✅ Fund blockchain wallet with 0.1 ETH
# ✅ Set ALLOWED_ORIGINS to your actual domains
# ✅ Enable Supabase PITR (Point-in-Time Recovery)
# ✅ Set up Railway/Render monitoring alerts
# ✅ Test with: ./tests/production_test.sh
# ✅ Backup this file (encrypted!) in password manager
#
# ==============================================================================
