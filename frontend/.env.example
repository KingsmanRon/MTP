# Inntris Frontend Configuration
# Copy this file to .env.local and fill in the values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Blockchain Explorer URL (Base L2)
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER=https://basescan.org

# AnchorRegistry Contract Address
NEXT_PUBLIC_ANCHOR_CONTRACT=0x...

# Admin session encryption secret (required in production).
# Run: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Redis URL for admin login rate limiting (optional, fail-open if unavailable)
REDIS_URL=redis://localhost:6379

# Optional: Enable debug mode
NEXT_PUBLIC_DEBUG=false
